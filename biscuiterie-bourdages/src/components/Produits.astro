---
import { Image } from 'astro:assets';
import bonbon from '../assets/produits/bonbons.jpg';
import snack from '../assets/produits/snacks.jpg';
import chocolat from '../assets/produits/chocolat.jpg';
import noix from '../assets/produits/noix.jpg';
import vin from '../assets/produits/vins.jpg';


const produits = [
  { image: bonbon, nom: 'Bonbons ' },
  { image: chocolat, nom: 'Chocolat ' },
  { image: noix, nom: 'Biscuits aux noix' },
  { image: snack, nom: 'Snacks' },
  { image: vin, nom: 'Confiture au vin' },
];

const largeurCarte = 400;
const hauteurCarte = 620;


const motifs = [
  { y: '0px', angle: '-4deg' },
  { y: '24px', angle: '3deg' },
  { y: '-10px', angle: '-2deg' },
];
const decalagePour = (indexProduit: number) => motifs[indexProduit % motifs.length];
---

<section id="produits" class="min-h-[130vh] flex flex-col items-center justify-center bg-bonbon text-framboise py-24 overflow-hidden">

  <div id="produits-titre" class="text-center mb-12 opacity-0">
    <h2 class="font-heading text-5xl font-black">Nos gourmandises</h2>
    <p class="font-body text-lg mt-2">Des biscuits et douceurs faits maison, à savourer sans modération</p>
  </div>

  <!-- la piste contient la liste QUADRUPLEE -->
  <div class="carrousel-piste flex w-max px-8 will-change-transform" data-nb-produits={produits.length}>
    {[...produits, ...produits, ...produits, ...produits].map((produit, i) => {
      const decalage = decalagePour(i % produits.length);
      return (
        <div
          class="carte-produit relative shrink-0 overflow-hidden rounded-3xl shadow-lg opacity-0"
          style={`width:${largeurCarte}px; height:${hauteurCarte}px; margin-left:${i === 0 ? '0' : '-5px'}; transform: translateY(${decalage.y}) rotate(${decalage.angle});`}
        >
          <!-- l'image recouvre toute la carte -->
          <Image src={produit.image} alt={produit.nom} class="absolute inset-0 h-full w-full object-cover" />
          <!-- voile sombre en bas pour que le texte reste lisible par dessus la photo -->
          <div class="absolute inset-0 bg-linear-to-t from-black/70 to-transparent"></div>
          <p class="absolute inset-x-0 bottom-4 font-text text-xl font-bold text-center text-creme">{produit.nom}</p>
        </div>
      );
    })}
  </div>

</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const piste = document.querySelector('.carrousel-piste') as HTMLElement;
  const titre = document.querySelector('#produits-titre')!;
  const cartes = document.querySelectorAll('.carte-produit');
  const nbProduits = Number(piste.dataset.nbProduits);

  // se joue quand le HAUT de la section atteint 75% de la hauteur de l'ecran en scrollant
  // (donc juste avant qu'elle soit pleinement visible), une seule fois
  gsap.timeline({
    scrollTrigger: {
      trigger: '#produits',
      start: 'top 75%'
    }
  })
    .fromTo(titre, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' })
    .fromTo(cartes, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.6, stagger: 0.08, ease: 'power2.out' }, '-=0.4');

  const premiereCarte = piste.children[0] as HTMLElement;
  const premiereCarteDupliquee = piste.children[nbProduits] as HTMLElement;
  const distanceBoucle = premiereCarteDupliquee.getBoundingClientRect().left - premiereCarte.getBoundingClientRect().left;

  
  gsap.to(piste, {
    x: `-=${distanceBoucle}`,
    duration: 40,
    ease: 'none',
    repeat: -1,
    force3D: true,
    modifiers: {
      x: gsap.utils.unitize((x: string) => parseFloat(x) % distanceBoucle)
    }
  });
</script>
