---
// Section "Notre histoire" : reveal simple au scroll — le texte apparaît, puis les
// deux photos se déposent comme des polaroids (chute + rotation qui se pose, joué
// une seule fois). Remplace l'ancienne séquence pinnée à cercles ; volontairement
// différente de la section Histoire d'Anny (glissement latéral scrubbé).
import { Image, getImage } from 'astro:assets';
import photo1 from '../assets/histoire/histoire1.png';
import photo2 from '../assets/histoire/histoire2.png';
import fondVichySrc from '../assets/produits/back.jpg';

// getImage() (pas <Image>) : produit une URL utilisable en background-image CSS,
// tout en gardant l'optimisation webp. Le vichy vient de la section Produits
// (les deux fonds ont été échangés).
const fondVichy = await getImage({ src: fondVichySrc, format: 'webp' });
---

<!-- margin-top négatif : la section glisse sous la découpe ondulée du bas de
     Produits ; padding et hauteur compensés des deux côtés (Visite remonte aussi
     de 120px par le bas). Voir hauteurSeparateur dans Produits.astro. -->
<section
  id="histoire"
  class="relative flex items-center overflow-hidden py-24 text-white"
  style="margin-top:-120px; padding-top:calc(6rem + 120px); padding-bottom:calc(6rem + 120px); min-height:calc(120vh + 240px);"
>

  <!-- Fond vichy séparé du contenu pour que le flou ne s'applique qu'à lui.
       scale-110 pousse le bord flou hors du cadre visible (overflow-hidden). -->
  <div
    class="absolute inset-0 scale-110 bg-cover bg-center bg-no-repeat blur-md"
    style={`background-image:url(${fondVichy.src});`}
  ></div>

  <div class="relative z-10 mx-auto flex w-full max-w-6xl flex-col items-center gap-12 px-6 md:flex-row md:justify-between md:gap-16">

    <div class="max-w-md text-center md:text-left">
      <h2 id="histoire-titre" class="font-heading text-3xl font-black opacity-0 sm:text-4xl md:text-5xl">Notre histoire</h2>
      <p id="histoire-paragraphe" class="mt-6 font-body text-sm opacity-0 sm:text-base md:text-lg">
        Tout a commencé dans une petite cuisine, avec une recette de famille et
        beaucoup de gourmandise. Aujourd'hui encore, chaque biscuit est préparé à la main.
      </p>
    </div>

    <!-- Les rotations de repos sont posées en style inline ; le tween GSAP ramène
         explicitement chaque photo à cette valeur (le décalage mt-10 de la seconde
         casse l'alignement trop propre). -->
    <div class="flex shrink-0 justify-center gap-4 sm:gap-8">
      <figure class="photo-histoire aspect-square w-40 overflow-hidden rounded-lg shadow-lg opacity-0 sm:w-56 md:w-72" style="transform: rotate(-5deg);">
        <Image src={photo1} alt="La gérante de la Biscuiterie Bourdages" class="h-full w-full object-cover" />
      </figure>
      <figure class="photo-histoire mt-10 aspect-square w-40 overflow-hidden rounded-lg shadow-lg opacity-0 sm:w-56 md:w-72" style="transform: rotate(4deg);">
        <Image src={photo2} alt="La boutique Biscuiterie Bourdages" class="h-full w-full object-cover" />
      </figure>
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { prefereMoinsAnimation as prefereMoinsAnimationCheck } from '@biscuiteries/ui/scripts/reduced-motion.ts';

  gsap.registerPlugin(ScrollTrigger);

  const titre = document.querySelector('#histoire-titre')!;
  const paragraphe = document.querySelector('#histoire-paragraphe')!;
  const photos = document.querySelectorAll('.photo-histoire');

  if (prefereMoinsAnimationCheck()) {
    // Version allégée : tout est affiché sans mouvement.
    gsap.set([titre, paragraphe, ...photos], { opacity: 1 });
  } else {
    // Scrub : l'animation est indexée sur la position de scroll (elle avance et
    // recule avec la molette). Le titre glisse depuis la gauche, le paragraphe
    // monte en fondu, puis chaque photo tombe et se pose avec un léger rebond
    // (back.out), de sa rotation exagérée vers sa rotation de repos.
    gsap.timeline({
      scrollTrigger: {
        trigger: '#histoire',
        start: 'top 80%',
        end: 'center 45%',
        scrub: 1
      }
    })
      .fromTo(titre, { opacity: 0, x: -60 }, { opacity: 1, x: 0, duration: 0.8, ease: 'power2.out' })
      .fromTo(paragraphe, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.4')
      .fromTo(photos,
        {
          opacity: 0,
          y: 70,
          scale: 1.06,
          rotation: (i) => (i === 0 ? -18 : 16)
        },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          rotation: (i) => (i === 0 ? -5 : 4),
          duration: 0.8,
          stagger: 0.18,
          ease: 'back.out(1.6)'
        },
        '-=0.4'
      );
  }
</script>
