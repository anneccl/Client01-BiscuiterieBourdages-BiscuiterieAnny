---
// Separateur decoratif reutilisable entre deux sections, en festons (meme technique
// que la navbar : clip-path SVG mesure dynamiquement). La bande du haut (couleurHaut)
// a un bord du bas en festons, posee sur la couleur de la section en dessous (couleurBas).
interface Props {
  couleurHaut?: string;
  couleurBas?: string;
  hauteur?: number;
}
const {
  couleurHaut = 'var(--color-bonbon)',
  couleurBas = 'var(--color-bonbon)',
  hauteur = 48,
} = Astro.props;

// id unique a chaque utilisation du composant, pour pouvoir en placer plusieurs sur la page
const idUnique = `festons-sep-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="relative w-full" style={`height:${hauteur}px; background-color:${couleurBas};`}>
  <svg width="0" height="0" class="absolute">
    <clipPath id={idUnique} clipPathUnits="userSpaceOnUse">
      <path class="festons-sep-path" d="" />
    </clipPath>
  </svg>
  <div
    class="festons-sep-bande absolute inset-0"
    style={`background-color:${couleurHaut}; clip-path:url(#${idUnique});`}
    data-clip-id={idUnique}
  ></div>
</div>

<script>
  import { cheminFestons } from '../scripts/festons';

  // il peut y avoir plusieurs separateurs sur la page : on traite chacun independamment
  document.querySelectorAll<HTMLElement>('.festons-sep-bande').forEach((bande) => {
    const chemin = document.querySelector<SVGPathElement>(
      `clipPath#${bande.dataset.clipId} path`
    )!;

    function ajuster() {
      const { width, height } = bande.getBoundingClientRect();
      // rayonCoin a 0 : pas de coins a arrondir, la bande va d'un bord a l'autre de l'ecran
      chemin.setAttribute('d', cheminFestons(width, height, 40, 16, 0));
    }

    ajuster();
    window.addEventListener('resize', ajuster);
  });
</script>
