---
// Page dédiée à une catégorie de produits (ex: /produits/chocolat), atteinte en
// cliquant une carte du carrousel "Nos gourmandises". Une page statique par
// catégorie, générée à partir de src/data/produits.ts.
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { categories } from '../../data/produits.ts';

export const getStaticPaths = (() =>
  categories.map((categorie) => ({
    params: { categorie: categorie.slug },
    props: { categorie },
  }))) satisfies GetStaticPaths;

const { categorie } = Astro.props;
---

<Layout>
  <section class="relative min-h-screen bg-surface px-6 py-32 text-primary">
    <div class="mx-auto max-w-6xl">
      <a href="/#produits" class="font-body text-sm font-semibold text-primary/70 transition-colors hover:text-primary">← Retour aux produits</a>

      <h1 class="mt-4 font-heading text-4xl font-black sm:text-5xl">{categorie.nom}</h1>

      <div class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
        {categorie.produits.map((produit) => (
          <figure class="overflow-hidden rounded-2xl shadow-lg">
            <Image src={produit.image} alt={produit.nom} class="h-56 w-full object-cover" />
            <figcaption class="mt-2 text-center font-body text-sm">{produit.nom}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Layout>
