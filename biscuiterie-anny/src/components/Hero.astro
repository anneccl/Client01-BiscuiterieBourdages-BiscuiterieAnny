---
// Première section visible après l'intro : image de fond floutée, titre/texte en fondu,
// et 6 vignettes flottantes/draggables (le même cookie décliné en rotations/positions
// différentes). Déclenché par l'événement "introTerminee", pas par le scroll.
// Même structure que le Hero de Bourdages.
// TODO : texte d'accroche à fournir (placeholder en attendant).
import { Image } from 'astro:assets';
import fond from '../assets/hero/background.png';
import cookie from '../assets/hero/cookie.png';

// Rotation et taille de repos de chaque vignette : comme c'est le même visuel répété
// six fois, les rotations et tailles variées évitent l'effet "copier-coller".
// Les classes de largeur sont des chaînes COMPLÈTES (pas de `w-${x}` dynamique) :
// Tailwind scanne le texte source et ne génère que les classes qu'il y voit écrites.
const cookies = [
  { rotation: -28, taille: 'w-14 sm:w-18 lg:w-24' },
  { rotation: -10, taille: 'w-20 sm:w-24 lg:w-32' },
  { rotation: 35,  taille: 'w-12 sm:w-16 lg:w-20' },
  { rotation: 12,  taille: 'w-18 sm:w-22 lg:w-28' },
  { rotation: -42, taille: 'w-11 sm:w-14 lg:w-18' },
  { rotation: 22,  taille: 'w-16 sm:w-20 lg:w-26' },
];
---

<section id="hero-principal" class="relative h-screen overflow-hidden">
  <Image src={fond} alt="Biscuiterie Anny" class="absolute inset-0 h-full w-full object-cover blur-sm" />

  <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-[#00000] px-6">
    <div class="relative">
      <h1 id="hero-titre" class="font-heading text-4xl font-black opacity-0 sm:text-6xl md:text-8xl">Biscuiterie Anny</h1>
      <p id="hero-texte" class="font-body text-base mt-4 opacity-0 sm:text-xl md:text-2xl"> Entreprise spécialisée dans la vente de bonbons, noix, chocolats et biscuits en vrac. De plus, nous offrons le service d'arrangement pour mariage et fête.</p>

      <!-- Position de repos pilotée par les variables CSS --ox/--oy (définies plus bas,
           par breakpoint) ; le transform reste en style inline car GSAP écrit
           directement dans style.transform pour le flottement et le drag. -->
      {cookies.map(({ rotation, taille }, i) => (
        <Image
          src={cookie}
          alt=""
          class={`vignette vignette-${i + 1} absolute top-1/2 left-1/2 h-auto cursor-grab opacity-0 ${taille}`}
          style={`transform: translate(calc(-50% + var(--ox)), calc(-50% + var(--oy))) rotate(${rotation}deg);`}
        />
      ))}
    </div>
  </div>
</section>

<style>
  /* Décalage de repos par vignette : resserré et réparti au-dessus/en dessous du texte
     sur téléphone, s'écarte progressivement par breakpoint jusqu'aux valeurs desktop. */
  .vignette-1 { --ox: -110px; --oy: -150px; }
  .vignette-2 { --ox: 0px; --oy: -165px; }
  .vignette-3 { --ox: -110px; --oy: 155px; }
  .vignette-4 { --ox: 110px; --oy: -150px; }
  .vignette-5 { --ox: 0px; --oy: 170px; }
  .vignette-6 { --ox: 110px; --oy: 160px; }

  @media (min-width: 640px) {
    .vignette-1 { --ox: -230px; --oy: -55px; }
    .vignette-2 { --ox: -250px; --oy: 10px; }
    .vignette-3 { --ox: -220px; --oy: 80px; }
    .vignette-4 { --ox: 230px; --oy: -50px; }
    .vignette-5 { --ox: 250px; --oy: 15px; }
    .vignette-6 { --ox: 220px; --oy: 80px; }
  }

  @media (min-width: 1024px) {
    .vignette-1 { --ox: -420px; --oy: -100px; }
    .vignette-2 { --ox: -460px; --oy: 20px; }
    .vignette-3 { --ox: -400px; --oy: 140px; }
    .vignette-4 { --ox: 420px; --oy: -90px; }
    .vignette-5 { --ox: 460px; --oy: 30px; }
    .vignette-6 { --ox: 400px; --oy: 150px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import Draggable from 'gsap/Draggable';
  import { prefereMoinsAnimation as prefereMoinsAnimationCheck } from '@biscuiteries/ui/scripts/reduced-motion.ts';

  gsap.registerPlugin(Draggable);

  const titre = document.querySelector('#hero-titre')!;
  const texte = document.querySelector('#hero-texte')!;
  const vignettes = document.querySelectorAll('.vignette');

  document.addEventListener('introTerminee', () => {
    // Version allégée : tout est affiché sans fondu ni flottement ; les vignettes
    // restent draggables (interaction volontaire, pas un mouvement imposé).
    if (prefereMoinsAnimationCheck()) {
      gsap.set([titre, texte, ...vignettes], { opacity: 1 });
      vignettes.forEach((vignette) => {
        Draggable.create(vignette, { bounds: '#hero-principal' });
      });
      return;
    }

    const tl = gsap.timeline();

    tl.fromTo(titre, { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 1, ease: 'power2.out' })
      .fromTo(texte, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power2.out' }, '-=0.4')
      .fromTo(vignettes, { opacity: 0, scale: 0 }, { opacity: 1, scale: 1, stagger: 0.1, duration: 0.6, ease: 'back.out(1.7)' }, '-=0.3');

    // Chaque vignette flotte en boucle et est draggable ; le flottement se met en
    // pause pendant le drag et redémarre au relâchement.
    const demarrerFlottement = (vignette: Element, i: number) =>
      gsap.to(vignette, {
        y: '+=15',
        duration: 2 + Math.random(),
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut',
        delay: i * 0.2
      });

    vignettes.forEach((vignette, i) => {
      let flottement = demarrerFlottement(vignette, i);

      Draggable.create(vignette, {
        bounds: '#hero-principal',
        onPress: () => flottement.kill(),
        onRelease: () => { flottement = demarrerFlottement(vignette, i); }
      });
    });
  });
</script>
